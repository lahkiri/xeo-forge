{
  "name": "xeo-forge",
  "version": "1.7.0-beta.1",
  "description": "The local-first control plane for agentic work: governed execution, persistent context, browser control, and auditable workflows.",
  "author": "Xeo Forge",
  "private": true,
  "main": "desktop/electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx scripts/db-init.ts",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run build && node scripts/prepare-desktop.mjs && electron .",
    "desktop:smoke": "npm run desktop:prepare && node scripts/smoke-desktop.mjs",
    "browser:smoke": "node scripts/smoke-browser-bridge.mjs",
    "desktop:build:win": "npm run desktop:prepare && electron-builder --win nsis --x64 --publish never",
    "desktop:build:linux": "npm run desktop:prepare && electron-builder --linux AppImage deb --x64 --publish never",
    "desktop:build:win:preview": "npm run desktop:prepare && electron-builder --win nsis --x64 --config.publish.channel=beta --publish never",
    "desktop:build:linux:preview": "npm run desktop:prepare && electron-builder --linux AppImage deb --x64 --config.publish.channel=beta --publish never",
    "verify:release:artifacts": "node scripts/verify-release-artifacts.mjs",
    "verify:release:artifacts:preview": "node scripts/verify-release-artifacts.mjs dist all beta"
  },
  "dependencies": {
    "better-sqlite3": "11.1.2",
    "electron-updater": "^6.8.9",
    "next": "^14.2.35",
    "openai": "4.56.0",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "10.0.0",
    "ws": "^8.21.3",
    "zod": "3.23.8"
  },
  "build": {
    "appId": "com.xeoforge.desktop",
    "productName": "Xeo Forge",
    "asar": true,
    "files": [
      "desktop/electron/**/*",
      ".next/standalone/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop/native/xeo-forge-runtime-broker.exe",
        "to": "native/xeo-forge-runtime-broker.exe"
      },
      {
        "from": "desktop/native/xeo-forge-runtime-broker",
        "to": "native/xeo-forge-runtime-broker"
      },
      {
        "from": ".next/standalone",
        "to": "app"
      },
      {
        "from": "desktop/browser-extension",
        "to": "browser-extension"
      }
    ],
    "icon": "desktop/assets/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Xeo-Forge-Setup-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "lahkiri",
      "repo": "xeo-forge",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "desktop/assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Xeo Forge <lahkiri@users.noreply.github.com>",
      "artifactName": "Xeo-Forge-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "20.14.10",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "10.0.0",
    "autoprefixer": "10.4.19",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "2.0.3"
  }
}
