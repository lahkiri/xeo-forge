# ---- Database ----
# If DATABASE_URL is set, PostgreSQL is used. Otherwise SQLite at data/xeo.db.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DB_PATH=data/xeo.db

# ---- Session ----
# Secret used to sign nothing currently; sessions use random tokens hashed in DB.
# Set NODE_ENV=production to enable secure cookies.

# ---- Root admin (seeded by `npm run db:init`) ----
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=change-me-now

# ---- Global model configuration (seeds model_settings row id=1) ----
# All users share this one model. No per-user selection.
MODEL_NAME=default
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-...
MODEL_ID=gpt-4o-mini
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4000

# ---- Agent workspace ----
# Per-task sandboxes are created under this directory.
TASK_WORK_DIR=/tmp/xeo-tasks

# ---- Credits ----
DEFAULT_DAILY_GRANT=50
