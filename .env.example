# ------------------------------------------------------------------
# Xeo Forge - environment configuration
# Copy to .env.local (dev) or set as environment variables (Docker).
# ------------------------------------------------------------------

# --- Database -------------------------------------------------------
# Leave DATABASE_URL unset for SQLite (local dev). Required in production
# (the app refuses SQLite when NODE_ENV=production).
# postgres://user:password@host:5432/dbname
# DATABASE_URL=

# SQLite file location (dev only). Default: <project>/data/xeo.db
# DB_PATH=./data/xeo.db

# Set to "1" to require an SSL connection to Postgres (e.g. managed hosts).
# PG_STRICT_SSL=1

# --- Root admin (seeded by `npm run db:init`) ------------------------
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=change-me-strong-password

# --- Global model (OpenAI-compatible endpoint) -----------------------
# One model for the whole platform. Seeded into model_settings (id=1) by
# db:init; afterwards editable by an admin in the UI.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-...
MODEL_ID=gpt-4o-mini
# Optional human-friendly model name (defaults to MODEL_ID).
MODEL_NAME=
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4000
# Total context window of the model in tokens (usage-% denominator).
MODEL_CONTEXT_WINDOW=128000
# Context usage % that triggers automatic compaction (10-95, default 80).
MODEL_AUTO_COMPACT_THRESHOLD=80

# --- Credits / pricing ----------------------------------------------
DEFAULT_DAILY_GRANT=50
CREDIT_TASK_CREATE=2
CREDIT_PER_TOOL_CALL=1

# --- Session cookie ---------------------------------------------------
# Set to "1" when serving over HTTPS so cookies are Secure-only.
# COOKIE_SECURE=1

# --- Agent workspace ---------------------------------------------------
# Root dir for per-task sandboxed workspaces. Default: /tmp/xeo-tasks
# TASK_WORK_DIR=/tmp/xeo-tasks
